---
// Ilustraciones vectoriales de productos (sin fotos reales aún: el emprendimiento está en desarrollo).
interface Props { kind: string; class?: string }
const { kind, class: cls = '' } = Astro.props;
const uid = `${kind}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg viewBox="0 0 200 200" class={cls} role="img" aria-hidden="true">
  <defs>
    <linearGradient id={`g1-${uid}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2bb3b1" /><stop offset=".55" stop-color="#27507a" /><stop offset="1" stop-color="#f2b43d" />
    </linearGradient>
    <linearGradient id={`g2-${uid}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f2b43d" /><stop offset="1" stop-color="#e39a1f" />
    </linearGradient>
  </defs>

  {kind === 'polo' && (
    <g>
      <path d="M62 38 L84 30 Q100 42 116 30 L138 38 L170 62 L154 88 L138 78 L138 170 L62 170 L62 78 L46 88 L30 62 Z" fill="#fff" stroke="#1d3b5e" stroke-width="3" stroke-linejoin="round" />
      <path d="M84 30 Q100 50 116 30" fill="none" stroke="#1d3b5e" stroke-width="3" />
      <path d="M86 92 C92 70 116 70 114 92 C112 108 94 104 100 122 C104 132 118 128 118 118" fill="none" stroke={`url(#g1-${uid})`} stroke-width="9" stroke-linecap="round" />
      <path d="M126 70 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z" fill="#f2b43d" />
      <rect x="80" y="140" width="40" height="6" rx="3" fill="#1d3b5e" opacity=".18" />
    </g>
  )}

  {kind === 'taza' && (
    <g>
      <path d="M140 80 h14 a22 22 0 0 1 0 44 h-14" fill="none" stroke="#1d3b5e" stroke-width="8" />
      <path d="M44 56 h100 v94 a18 18 0 0 1 -18 18 h-64 a18 18 0 0 1 -18 -18 z" fill="#fff" stroke="#1d3b5e" stroke-width="3" />
      <ellipse cx="94" cy="56" rx="50" ry="8" fill="#e3f2fd" stroke="#1d3b5e" stroke-width="3" />
      <rect x="58" y="80" width="72" height="56" rx="12" fill={`url(#g1-${uid})`} />
      <path d="M72 122 l14 -18 10 12 8 -8 14 14z" fill="#fff" opacity=".85" />
      <circle cx="112" cy="94" r="6" fill="#fff" opacity=".9" />
      <path d="M80 30 q6 -8 0 -16 M96 34 q6 -8 0 -16 M112 30 q6 -8 0 -16" fill="none" stroke="#2bb3b1" stroke-width="3" stroke-linecap="round" opacity=".6" />
    </g>
  )}

  {kind === 'gorra' && (
    <g>
      <path d="M40 124 C40 70 76 48 104 48 C140 48 162 76 162 124 Z" fill="#1d3b5e" />
      <path d="M40 124 C70 116 130 114 186 132 C176 146 120 144 40 132 Z" fill="#27507a" stroke="#13263f" stroke-width="2" />
      <path d="M104 48 C96 70 94 100 98 122" fill="none" stroke="#13263f" stroke-width="2" opacity=".5" />
      <circle cx="104" cy="50" r="5" fill="#f2b43d" />
      <rect x="62" y="80" width="52" height="30" rx="8" fill="#fff" />
      <text x="88" y="101" text-anchor="middle" font-family="Montserrat Variable, sans-serif" font-weight="800" font-size="16" fill="#1f8f93">TU</text>
      <path d="M130 74 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z" fill="#f2b43d" />
    </g>
  )}

  {kind === 'tote' && (
    <g>
      <path d="M72 70 C72 30 128 30 128 70" fill="none" stroke="#1d3b5e" stroke-width="7" stroke-linecap="round" />
      <path d="M46 68 h108 l-6 104 h-96 z" fill="#f6ecd9" stroke="#1d3b5e" stroke-width="3" stroke-linejoin="round" />
      <circle cx="100" cy="116" r="30" fill="none" stroke={`url(#g1-${uid})`} stroke-width="7" />
      <path d="M100 96 l6 14 14 6 -14 6 -6 14 -6 -14 -14 -6 14 -6z" fill="#f2b43d" />
    </g>
  )}

  {kind === 'cojin' && (
    <g>
      <path d="M40 46 Q100 34 160 46 Q172 100 160 154 Q100 166 40 154 Q28 100 40 46 Z" fill={`url(#g1-${uid})`} stroke="#13263f" stroke-width="3" />
      <path d="M100 80 C88 64 64 72 70 94 C76 114 100 126 100 126 C100 126 124 114 130 94 C136 72 112 64 100 80 Z" fill="#fff" />
      <path d="M52 58 l3 6 6 3 -6 3 -3 6 -3 -6 -6 -3 6 -3z M148 132 l3 6 6 3 -6 3 -3 6 -3 -6 -6 -3 6 -3z" fill="#f2b43d" />
    </g>
  )}

  {kind === 'uniforme' && (
    <g>
      <path d="M62 36 L86 30 L100 44 L114 30 L138 36 L170 60 L154 88 L138 78 L138 170 L62 170 L62 78 L46 88 L30 60 Z" fill="#1f8f93" stroke="#13263f" stroke-width="3" stroke-linejoin="round" />
      <path d="M86 30 L100 44 L114 30" fill="none" stroke="#f2b43d" stroke-width="5" stroke-linejoin="round" />
      <path d="M62 78 L62 170 M138 78 L138 170" stroke="#f2b43d" stroke-width="6" />
      <text x="100" y="94" text-anchor="middle" font-family="Montserrat Variable, sans-serif" font-weight="800" font-size="11" letter-spacing="1.5" fill="#fff">KARBELL</text>
      <text x="100" y="150" text-anchor="middle" font-family="Montserrat Variable, sans-serif" font-weight="900" font-size="50" fill="#fff">10</text>
    </g>
  )}
</svg>
