---
const items = ['Polos', 'Tazas', 'Gorras', 'Tote bags', 'Cojines', 'Uniformes', 'Termos', 'Regalos personalizados', 'Merch para tu marca', 'Promociones'];
---
<div class="relative overflow-hidden bg-navy py-4 text-white" aria-hidden="true">
  <div class="animate-marquee flex w-max gap-10 whitespace-nowrap font-display text-sm font-bold uppercase tracking-[0.2em]">
    {[...items, ...items].map((t) => (
      <span class="flex items-center gap-10">{t}<svg viewBox="0 0 24 24" class="size-3.5 text-gold" fill="currentColor"><path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" /></svg></span>
    ))}
  </div>
</div>
