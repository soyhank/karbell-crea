---
import { stats } from '../data/content';
---
<section id="inicio" class="relative overflow-hidden pt-10 pb-20 sm:pt-16 lg:pb-24">
  <div class="dots pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_70%)]"></div>
  <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sky/70 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-32 size-[28rem] rounded-full bg-gold/15 blur-3xl"></div>

  <div class="container-x relative grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <a href="/opiniones" class="reveal inline-flex items-center gap-2 rounded-full border border-teal/25 bg-white/80 px-4 py-1.5 text-xs font-semibold text-navy shadow-sm">
        <span class="tracking-widest text-gold">★★★★★</span> 4.9 de calificación · +1,200 pedidos en Lima
      </a>
      <h1 class="reveal mt-6 text-4xl font-extrabold leading-[1.05] text-navy sm:text-5xl lg:text-6xl" style="--d:80ms">
        Tus ideas, <span class="text-gradient">estampadas</span> con color que dura.
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-ink/70" style="--d:160ms">
        Polos, tazas, gorras, tote bags y más, personalizados con
        {' '}<strong class="text-teal">sublimación</strong> y <strong class="text-teal">vinil textil</strong>.
        Desde 1 unidad, con vista previa gratis antes de producir.
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-3" style="--d:240ms">
        <a href="/tienda" class="btn btn-primary">
          Ver tienda y precios
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="/packs" class="btn btn-outline">Ver packs de regalo</a>
      </div>
      <dl class="reveal mt-12 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 border-t border-navy/10 pt-8 sm:grid-cols-4" style="--d:320ms">
        {stats.map((s) => (
          <div><dd class="font-display text-2xl font-extrabold text-navy">{s.n}</dd><dt class="text-xs leading-snug text-ink/55">{s.l}</dt></div>
        ))}
      </dl>
    </div>

    <div class="reveal relative mx-auto grid w-full max-w-[32rem] grid-cols-2 gap-4" style="--d:200ms">
      <div class="grid gap-4 pt-10">
        <img src="/img/p-taza-mama.webp" alt="Taza personalizada con diseño para mamá" width="800" height="800" class="aspect-square w-full rounded-[1.75rem] object-cover shadow-lift" fetchpriority="high" />
        <img src="/img/p-gorra.webp" alt="Gorra blanca con vinil textil" width="800" height="800" class="aspect-[4/3] w-full rounded-[1.75rem] object-cover shadow-soft" />
      </div>
      <div class="grid gap-4">
        <img src="/img/p-polo-vinil.webp" alt="Polo blanco con frase en vinil textil" width="800" height="800" class="aspect-[4/5] w-full rounded-[1.75rem] object-cover shadow-soft" />
        <img src="/img/p-cojin.webp" alt="Cojín sublimado Hogar dulce hogar" width="800" height="800" class="aspect-square w-full rounded-[1.75rem] object-cover shadow-lift" />
      </div>
      <div class="animate-floaty absolute -left-4 top-1/2 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-lift sm:-left-10" style="--r:-3deg">
        <span class="grid size-10 place-items-center rounded-xl bg-teal/10 text-teal">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>
        </span>
        <span class="text-xs leading-tight"><strong class="block text-sm text-navy">Entrega en 48 h</strong>Lima y Callao</span>
      </div>
      <div class="animate-floaty absolute -right-3 top-4 rounded-2xl bg-gold px-4 py-2.5 text-center shadow-lift" style="--r:5deg; animation-delay:-3s">
        <span class="block text-[0.65rem] font-bold uppercase tracking-wider text-ink/70">Tazas desde</span>
        <span class="font-display text-xl font-black text-ink">S/ 18</span>
      </div>
    </div>
  </div>
</section>
