---
import Illustration from './Illustration.astro';
---
<section id="inicio" class="relative overflow-hidden pt-28 pb-20 sm:pt-36 lg:pb-28">
  <div class="dots pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_70%)]"></div>
  <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sky/70 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-32 size-[28rem] rounded-full bg-gold/15 blur-3xl"></div>

  <div class="container-x relative grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <span class="reveal inline-flex items-center gap-2 rounded-full border border-teal/25 bg-white/80 px-4 py-1.5 text-xs font-semibold text-teal shadow-sm">
        <span class="relative flex size-2"><span class="absolute inset-0 animate-ping rounded-full bg-gold"></span><span class="relative size-2 rounded-full bg-gold"></span></span>
        Emprendimiento en camino · lanzamiento próximo
      </span>
      <h1 class="reveal mt-6 text-4xl font-extrabold leading-[1.05] text-navy sm:text-5xl lg:text-6xl" style="--d:80ms">
        Tus ideas, <span class="text-gradient">estampadas</span> con color que dura.
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-ink/70" style="--d:160ms">
        En <strong class="text-navy">Karbell Crea</strong> personalizamos polos, tazas, gorras, tote bags y más con
        {' '}<strong class="text-teal">sublimación</strong> y <strong class="text-teal">vinil textil</strong>.
        Para regalar, para tu marca o para tu equipo.
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-3" style="--d:240ms">
        <a href="#contacto" class="btn btn-primary">
          Cuéntanos tu idea
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#servicios" class="btn btn-outline">Ver qué personalizamos</a>
      </div>
      <dl class="reveal mt-12 grid max-w-lg grid-cols-3 gap-4 border-t border-navy/10 pt-8" style="--d:320ms">
        <div><dt class="text-xs text-ink/55">Técnicas</dt><dd class="font-display text-xl font-bold text-navy">2</dd></div>
        <div><dt class="text-xs text-ink/55">Pedidos desde</dt><dd class="font-display text-xl font-bold text-navy">1 unidad</dd></div>
        <div><dt class="text-xs text-ink/55">Diseño</dt><dd class="font-display text-xl font-bold text-navy">A tu medida</dd></div>
      </dl>
    </div>

    <div class="reveal relative mx-auto aspect-square w-full max-w-[30rem]" style="--d:200ms">
      <div class="absolute inset-6 rounded-full border-2 border-dashed border-teal/30 animate-spin-slow"></div>
      <div class="absolute inset-14 rounded-full bg-gradient-to-br from-white to-sky-2 shadow-lift"></div>
      <img src="/img/logo-karbell.png" alt="Logo de Karbell Crea" width="659" height="610" class="absolute inset-0 m-auto w-[44%] -translate-y-[8%] drop-shadow-sm" fetchpriority="high" />

      <div class="animate-floaty absolute -left-2 top-6 w-32 rounded-3xl bg-white p-3 shadow-lift sm:w-36" style="--r:-6deg">
        <Illustration kind="polo" class="w-full" />
        <p class="text-center text-xs font-semibold text-navy">Polos</p>
      </div>
      <div class="animate-floaty absolute -right-2 top-16 w-28 rounded-3xl bg-white p-3 shadow-lift sm:w-32" style="--r:7deg; animation-delay:-2s">
        <Illustration kind="taza" class="w-full" />
        <p class="text-center text-xs font-semibold text-navy">Tazas</p>
      </div>
      <div class="animate-floaty absolute bottom-0 left-1/2 w-28 -translate-x-1/2 rounded-3xl bg-white p-3 shadow-lift sm:w-32" style="--r:-3deg; animation-delay:-4s">
        <Illustration kind="gorra" class="w-full" />
        <p class="text-center text-xs font-semibold text-navy">Gorras</p>
      </div>

      <svg viewBox="0 0 24 24" class="animate-twinkle absolute right-10 bottom-20 size-7 text-gold" fill="currentColor"><path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" /></svg>
      <svg viewBox="0 0 24 24" class="animate-twinkle absolute left-12 bottom-24 size-4 text-teal" style="animation-delay:-1.2s" fill="currentColor"><path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" /></svg>
    </div>
  </div>
</section>
