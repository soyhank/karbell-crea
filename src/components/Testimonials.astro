---
import { testimonials as all } from '../data/social';
interface Props { limit?: number }
const { limit } = Astro.props;
const testimonials = limit ? all.slice(0, limit) : all;
const colors = ['bg-teal', 'bg-navy-2', 'bg-gold-2', 'bg-navy', 'bg-teal-2', 'bg-[#c9665b]'];
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
---
<section id="opiniones" class="relative overflow-hidden bg-sky-2 py-24 sm:py-28">
  <div class="dots pointer-events-none absolute inset-0 opacity-60"></div>
  <div class="container-x relative">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Opiniones</p>
      <h2 class="mt-4 text-3xl font-extrabold text-navy sm:text-4xl">Lo que dicen nuestros clientes</h2>
      <p class="mt-4 flex items-center justify-center gap-2 text-ink/65">
        <span class="text-lg tracking-widest text-gold">★★★★★</span> 4.9 de 5 · basado en 312 reseñas
      </p>
    </div>
    <div class="mt-14 columns-1 gap-6 sm:columns-2 lg:columns-3">
      {testimonials.map((t, i) => (
        <figure class="reveal mb-6 break-inside-avoid rounded-[1.75rem] bg-white p-7 shadow-soft" style={`--d:${(i % 3) * 90}ms`}>
          <div class="text-gold" aria-label={`${t.stars} de 5 estrellas`}>{'★'.repeat(t.stars)}<span class="text-navy/15">{'★'.repeat(5 - t.stars)}</span></div>
          <blockquote class="mt-4 leading-relaxed text-ink/80">“{t.text}”</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span class={`grid size-11 place-items-center rounded-full font-display text-sm font-bold text-white ${colors[i % colors.length]}`}>{initials(t.name)}</span>
            <span class="text-sm leading-tight">
              <strong class="block text-navy">{t.name}</strong>
              <span class="text-ink/55">{t.place} · {t.product}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    {limit && <div class="mt-4 text-center"><a href="/opiniones" class="btn btn-outline">Ver todas las opiniones</a></div>}
  </div>
</section>
