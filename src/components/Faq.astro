---
import { faqs } from '../data/social';
---
<section id="faq" class="py-24 sm:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="reveal">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 class="mt-4 text-3xl font-extrabold text-navy sm:text-4xl">Todo lo que necesitas saber antes de pedir</h2>
      <p class="mt-4 text-ink/65">¿Tienes otra duda? Escríbenos y te respondemos el mismo día.</p>
      <a href="/contacto" class="btn btn-outline mt-8">Hacer una consulta</a>
    </div>
    <div class="grid gap-3">
      {faqs.map((f, i) => (
        <details class="reveal group rounded-3xl border border-navy/10 bg-white px-6 py-5 shadow-sm open:shadow-soft" style={`--d:${i * 60}ms`} open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy">
            {f.q}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-mist text-teal transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-ink/70">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})} />
