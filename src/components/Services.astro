---
import Illustration from './Illustration.astro';
import { services } from '../data/services';
import { mailto } from '../data/site';
---
<section id="servicios" class="py-24 sm:py-28">
  <div class="container-x">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Qué personalizamos</p>
      <h2 class="mt-4 text-3xl font-extrabold text-navy sm:text-4xl">Si se puede estampar, lo hacemos tuyo</h2>
      <p class="mt-4 text-ink/65">Elige el producto, trae tu idea y nosotros nos encargamos del diseño y del acabado.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <article class="reveal group relative flex flex-col overflow-hidden rounded-[2rem] border border-navy/8 bg-white p-6 shadow-soft transition duration-500 hover:-translate-y-1.5 hover:shadow-lift" style={`--d:${(i % 3) * 90}ms`}>
          <div class="relative grid aspect-[4/3] place-items-center overflow-hidden rounded-3xl bg-gradient-to-br from-sky-2 to-sky/60">
            <div class="dots absolute inset-0 opacity-60"></div>
            <Illustration kind={s.id} class="relative w-[58%] transition duration-500 group-hover:scale-110 group-hover:-rotate-3" />
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {s.tech.map((t) => (
              <span class={`rounded-full px-3 py-1 text-[0.7rem] font-bold uppercase tracking-wider ${t === 'Sublimación' ? 'bg-teal/10 text-teal' : 'bg-gold/20 text-gold-2'}`}>{t}</span>
            ))}
          </div>
          <h3 class="mt-3 text-xl font-bold text-navy">{s.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/65">{s.text}</p>
          <p class="mt-4 text-xs text-ink/50">Ideal para: {s.ideas.join(' · ')}</p>
          <a href={mailto(`Cotización: ${s.title}`, `Hola Karbell Crea, me interesa personalizar: ${s.title}.\n\nCantidad aproximada:\nIdea o diseño:\nFecha en que lo necesito:\n`)} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-teal transition group-hover:gap-3">
            Pedir cotización
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </article>
      ))}
    </div>
    <p class="reveal mt-8 text-center text-xs text-ink/45">Ilustraciones referenciales. Muy pronto compartiremos fotos de nuestros primeros trabajos.</p>
  </div>
</section>
