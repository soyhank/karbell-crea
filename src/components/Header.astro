---
import { site, mailto } from '../data/site';
const links = [
  { href: '#servicios', label: 'Qué personalizamos' },
  { href: '#tecnicas', label: 'Técnicas' },
  { href: '#proceso', label: 'Cómo trabajamos' },
  { href: '#contacto', label: 'Contacto' },
];
---
<header id="top-bar" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-x flex h-18 items-center justify-between gap-4">
    <a href="#inicio" class="flex items-center gap-2.5" aria-label={`${site.name}, inicio`}>
      <img src="/img/isotipo.png" alt="" width="289" height="368" class="h-10 w-auto" />
      <span class="font-display text-lg font-extrabold leading-none tracking-tight text-navy">
        KARBELL <span class="block text-[0.62rem] font-semibold tracking-[0.42em] text-teal">CREA</span>
      </span>
    </a>
    <nav class="hidden items-center gap-7 text-sm font-medium text-ink/75 md:flex" aria-label="Principal">
      {links.map((l) => <a href={l.href} class="transition hover:text-teal">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a href={mailto('Quiero cotizar un pedido')} class="btn btn-primary hidden !px-5 !py-2.5 sm:inline-flex">Cotizar</a>
      <button id="menu-btn" class="grid size-11 place-items-center rounded-full border border-navy/15 bg-white/70 md:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="container-x hidden pb-5 md:hidden" aria-label="Móvil">
    <div class="grid gap-1 rounded-3xl border border-navy/10 bg-white p-3 shadow-soft">
      {links.map((l) => <a href={l.href} class="rounded-2xl px-4 py-3 font-medium hover:bg-sky-2">{l.label}</a>)}
      <a href={mailto('Quiero cotizar un pedido')} class="btn btn-primary mt-1">Cotizar mi pedido</a>
    </div>
  </nav>
</header>

<script>
  const bar = document.getElementById('top-bar')!;
  const btn = document.getElementById('menu-btn')!;
  const nav = document.getElementById('mobile-nav')!;
  const onScroll = () => {
    const s = window.scrollY > 12;
    bar.classList.toggle('bg-white/85', s);
    bar.classList.toggle('backdrop-blur-md', s);
    bar.classList.toggle('shadow-soft', s);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  btn.addEventListener('click', () => {
    const open = nav.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    if (open) bar.classList.add('bg-white/85', 'backdrop-blur-md');
  });
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { nav.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); }));
</script>
