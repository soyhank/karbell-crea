---
import Shop from '../layouts/Shop.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, categories } from '../data/products';
---
<Shop title="Tienda | Karbell Crea" description="Polos, tazas, termos, gorras, tote bags, cojines y camisetas deportivas personalizadas. Precios por unidad y por docena.">
  <PageHeader eyebrow="Tienda" title="Productos personalizados" text="Precios por unidad con diseño básico incluido. Desde 12 unidades del mismo producto pagas el precio por docena." crumbs={[{ label: 'Tienda' }]} />

  <section class="py-14 sm:py-16">
    <div class="container-x">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filtrar por categoría">
          <button class="chip is-active" data-filter="all">Todos <span class="opacity-60">({products.length})</span></button>
          {categories.map((c) => <button class="chip" data-filter={c}>{c}</button>)}
        </div>
        <select id="sort" class="field !w-auto !rounded-full !py-2.5" aria-label="Ordenar">
          <option value="pop">Más populares</option>
          <option value="asc">Precio: menor a mayor</option>
          <option value="desc">Precio: mayor a menor</option>
        </select>
      </div>
      <div id="grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {products.map((p, i) => <div data-price={p.price} data-i={i} class="contents"><ProductCard p={p} delay={(i % 4) * 60} /></div>)}
      </div>

      <div class="mt-16 flex flex-col items-center justify-between gap-6 rounded-[2rem] border border-navy/10 bg-white p-8 shadow-soft sm:flex-row">
        <div>
          <p class="font-display text-xl font-extrabold text-navy">¿Compras para regalar o para tu negocio?</p>
          <p class="mt-1 text-ink/60">Nuestros packs combinan productos con hasta 17 % de descuento.</p>
        </div>
        <a href="/packs" class="btn btn-gold shrink-0">Ver packs</a>
      </div>
    </div>
  </section>
</Shop>

<style>
  @reference '../styles/global.css';
  .chip { @apply rounded-full border border-navy/15 bg-white px-4 py-2 text-sm font-medium text-ink/70 transition hover:border-teal hover:text-teal; }
  .chip.is-active { @apply border-navy bg-navy text-white; }
</style>

<script>
  const grid = document.getElementById('grid')!;
  const wrappers = [...grid.children] as HTMLElement[];
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

  function filter(cat: string) {
    chips.forEach((c) => c.classList.toggle('is-active', c.dataset.filter === cat));
    wrappers.forEach((w) => {
      const card = w.firstElementChild as HTMLElement;
      w.style.display = cat === 'all' || card.dataset.cat === cat ? 'contents' : 'none';
      card.classList.add('in');
    });
    const url = new URL(location.href);
    cat === 'all' ? url.searchParams.delete('cat') : url.searchParams.set('cat', cat);
    history.replaceState(null, '', url);
  }
  chips.forEach((c) => c.addEventListener('click', () => filter(c.dataset.filter!)));

  document.getElementById('sort')!.addEventListener('change', (e) => {
    const v = (e.target as HTMLSelectElement).value;
    const key = (w: HTMLElement) => (v === 'pop' ? +w.dataset.i! : +w.dataset.price!);
    wrappers.sort((a, b) => (v === 'desc' ? key(b) - key(a) : key(a) - key(b))).forEach((w) => grid.appendChild(w));
  });

  const initial = new URLSearchParams(location.search).get('cat');
  if (initial) filter(initial);
</script>
