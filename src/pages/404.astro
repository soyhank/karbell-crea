---
import Shop from '../layouts/Shop.astro';
---
<Shop title="Página no encontrada | Karbell Crea">
  <section class="py-28 text-center">
    <div class="container-x">
      <p class="font-display text-8xl font-black text-gradient">404</p>
      <h1 class="mt-4 text-3xl font-extrabold text-navy">Esta página no existe</h1>
      <p class="mt-2 text-ink/60">Puede que el enlace haya cambiado. Mira nuestra tienda o vuelve al inicio.</p>
      <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn btn-primary">Ir al inicio</a><a href="/tienda" class="btn btn-outline">Ver tienda</a></div>
    </div>
  </section>
</Shop>
