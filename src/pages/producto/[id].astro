---
import Shop from '../../layouts/Shop.astro';
import ProductCard from '../../components/ProductCard.astro';
import PackCard from '../../components/PackCard.astro';
import { products, soles, type Product } from '../../data/products';
import { packs, regular, saving, includesText, type Pack } from '../../data/packs';
import { site } from '../../data/site';

export function getStaticPaths() {
  return [
    ...products.map((p) => ({ params: { id: p.id }, props: { product: p } })),
    ...packs.map((p) => ({ params: { id: p.id }, props: { pack: p } })),
  ];
}

const { product, pack } = Astro.props as { product?: Product; pack?: Pack };
const item = (product ?? pack)!;
const isPack = !!pack;
const category = product ? product.category : pack!.audience === 'Regalos' ? 'Packs de regalo' : 'Packs para negocios';
const specs = product ? product.specs : pack!.extras;
const cartItem = { id: item.id, kind: isPack ? 'pack' : 'product', name: item.name, price: item.price, dozen: product?.dozen, img: item.img };
const relatedProducts = product ? products.filter((p) => p.category === product.category && p.id !== product.id).concat(products.filter((p) => p.category !== product.category)).slice(0, 4) : [];
const relatedPacks = pack ? packs.filter((p) => p.id !== pack.id && p.audience === pack.audience).slice(0, 3) : [];
const pixel = { content_ids: [item.id], content_name: item.name, content_category: category, content_type: 'product', value: item.price, currency: 'PEN' };
const schema = {
  '@context': 'https://schema.org', '@type': 'Product', name: item.name, image: `${site.url}${item.img}`, description: item.desc,
  brand: { '@type': 'Brand', name: site.name },
  offers: { '@type': 'Offer', priceCurrency: 'PEN', price: item.price, availability: 'https://schema.org/InStock', url: `${site.url}/producto/${item.id}` },
};
---
<Shop title={`${item.name} | Karbell Crea`} description={item.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="py-10 sm:py-14">
    <div class="container-x">
      <nav aria-label="Ruta" class="text-xs text-ink/50">
        <a href="/" class="hover:text-teal">Inicio</a><span class="mx-2">/</span>
        <a href={isPack ? '/packs' : '/tienda'} class="hover:text-teal">{isPack ? 'Packs' : 'Tienda'}</a><span class="mx-2">/</span>
        <span class="text-ink/75">{item.name}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="relative">
          <div class="sticky top-28 overflow-hidden rounded-[2rem] bg-sky-2 shadow-soft">
            <img src={item.img} alt={item.name} width="800" height="800" class="aspect-square w-full object-cover" fetchpriority="high" />
            {item.badge && <span class="absolute top-5 left-5 rounded-full bg-gold px-3 py-1 text-xs font-bold uppercase tracking-wider text-ink shadow">{item.badge}</span>}
          </div>
        </div>

        <div id="buy" data-item={JSON.stringify(cartItem)} data-pixel={JSON.stringify(pixel)}>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-teal">{category}{product && ` · ${product.tech}`}</p>
          <h1 class="mt-2 text-3xl font-extrabold leading-tight text-navy sm:text-4xl">{item.name}</h1>
          <div class="mt-3 flex items-center gap-2 text-sm text-ink/60"><span class="tracking-widest text-gold">★★★★★</span> 4.9 · {isPack ? 'Pack más elegido para regalar' : 'Más de 100 vendidos'}</div>

          <div class="mt-6 flex flex-wrap items-end gap-x-4 gap-y-1">
            {isPack && <span class="text-lg text-ink/45 line-through">{soles(regular(pack!))}</span>}
            <span class="font-display text-4xl font-black text-ink">{soles(item.price)}</span>
            {isPack && <span class="rounded-full bg-teal/10 px-3 py-1 text-sm font-bold text-teal">Ahorras {soles(saving(pack!))}</span>}
            {product?.dozen && <span class="text-sm text-teal">Desde 12 u.: <strong>{soles(product.dozen)}</strong> c/u</span>}
          </div>

          <p class="mt-5 text-lg leading-relaxed text-ink/70">{item.desc}</p>

          {isPack && (
            <div class="mt-6 rounded-3xl border border-navy/10 bg-white p-5">
              <p class="text-sm font-bold text-navy">Este pack incluye</p>
              <ul class="mt-3 grid gap-2 text-sm text-ink/75">
                {includesText(pack!).map((t) => <li class="flex gap-2"><span class="text-teal">✓</span>{t}</li>)}
              </ul>
            </div>
          )}

          <ul class="mt-6 grid gap-2 text-sm text-ink/75 sm:grid-cols-2">
            {specs.map((s) => <li class="flex gap-2"><span class="text-gold">✦</span>{s}</li>)}
          </ul>

          {product?.options && (
            <label class="mt-7 grid max-w-xs gap-1.5 text-sm font-semibold text-navy">{product.options.label}
              <select data-option class="field font-normal">{product.options.values.map((v, i) => <option selected={i === 1}>{v}</option>)}</select>
            </label>
          )}

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <div class="flex items-center rounded-full border border-navy/15 bg-white">
              <button type="button" data-qty="-1" class="grid size-12 place-items-center text-xl" aria-label="Menos">−</button>
              <input data-qty-input type="number" min="1" value="1" class="w-14 bg-transparent text-center text-lg font-semibold outline-none" aria-label="Cantidad" />
              <button type="button" data-qty="1" class="grid size-12 place-items-center text-xl" aria-label="Más">+</button>
            </div>
            <p data-total class="text-sm text-ink/60"></p>
          </div>

          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <button data-add class="btn btn-gold !py-4">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7L6 7z" /><path d="M9 7a3 3 0 0 1 6 0" /></svg>
              Agregar al carrito
            </button>
            <button data-buy-wa class="btn bg-[#25d366] !py-4 text-white hover:-translate-y-0.5">Comprar por WhatsApp</button>
          </div>

          <div class="mt-8 grid gap-3 rounded-3xl bg-sky-2 p-5 text-sm text-ink/75 sm:grid-cols-3">
            <p><strong class="block text-navy">Vista previa gratis</strong>Antes de producir</p>
            <p><strong class="block text-navy">Listo en 24–72 h</strong>Según cantidad</p>
            <p><strong class="block text-navy">Pago seguro</strong>Yape, Plin o transferencia</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-navy/8 py-16 sm:py-20">
    <div class="container-x">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">{isPack ? 'Otros packs que te pueden gustar' : 'También te puede interesar'}</h2>
      <div class:list={['mt-8 grid gap-6', isPack ? 'md:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4']}>
        {relatedProducts.map((p, i) => <ProductCard p={p} delay={i * 60} />)}
        {relatedPacks.map((p, i) => <PackCard p={p} delay={i * 60} />)}
      </div>
    </div>
  </section>
</Shop>

<script>
  import { addItem, openDrawer, unit, soles, type CartItem } from '../../scripts/cart';

  const box = document.getElementById('buy')!;
  const base = JSON.parse(box.dataset.item!) as CartItem;
  const pixel = JSON.parse(box.dataset.pixel!);
  const qty = box.querySelector<HTMLInputElement>('[data-qty-input]')!;
  const opt = box.querySelector<HTMLSelectElement>('[data-option]');

  const current = (): CartItem => ({ ...base, qty: Math.max(1, parseInt(qty.value) || 1), option: opt?.value });
  const refresh = () => {
    const it = current();
    box.querySelector('[data-total]')!.textContent = `Total: ${soles(unit(it) * it.qty)}${it.dozen && it.qty >= 12 ? ' · precio por docena aplicado' : ''}`;
  };

  window.kcTrack('ViewContent', pixel);

  box.querySelectorAll<HTMLElement>('[data-qty]').forEach((b) =>
    b.addEventListener('click', () => { qty.value = String(Math.max(1, (parseInt(qty.value) || 1) + Number(b.dataset.qty))); refresh(); }),
  );
  qty.addEventListener('input', refresh);
  box.querySelector('[data-add]')!.addEventListener('click', () => { addItem(current()); openDrawer(); });
  box.querySelector('[data-buy-wa]')!.addEventListener('click', () => {
    const it = current();
    const total = unit(it) * it.qty;
    window.kcTrack('InitiateCheckout', { ...pixel, value: total, num_items: it.qty });
    const msg = `Hola Karbell Crea 👋 Quiero comprar:\n\n• ${it.qty} × ${it.name}${it.option ? ` (${it.option})` : ''}\nTotal: ${soles(total)}\n\n${location.href}\n\n¿Me ayudan con el diseño y la entrega?`;
    window.open(window.kcWa(msg), '_blank', 'noopener');
  });
  refresh();
</script>
