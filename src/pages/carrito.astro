---
import Shop from '../layouts/Shop.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Shop title="Mi carrito | Karbell Crea" description="Revisa tu pedido y envíalo por WhatsApp.">
  <PageHeader eyebrow="Carrito" title="Finaliza tu pedido" text="Revisa tus productos, completa tus datos y envíanos el pedido por WhatsApp. Te confirmamos el diseño y los datos de pago al instante." crumbs={[{ label: 'Carrito' }]} />

  <section class="py-12 sm:py-16">
    <div class="container-x">
      <div id="empty" class="hidden rounded-[2rem] border border-navy/10 bg-white p-12 text-center shadow-soft">
        <p class="text-6xl">🛍️</p>
        <h2 class="mt-4 text-2xl font-extrabold text-navy">Tu carrito está vacío</h2>
        <p class="mt-2 text-ink/60">Elige tus productos o un pack para empezar.</p>
        <div class="mt-6 flex justify-center gap-3"><a href="/tienda" class="btn btn-primary">Ir a la tienda</a><a href="/packs" class="btn btn-outline">Ver packs</a></div>
      </div>

      <div id="done" class="hidden rounded-[2rem] border border-navy/10 bg-white p-12 text-center shadow-soft">
        <div class="mx-auto grid size-16 place-items-center rounded-full bg-[#25d366] text-3xl text-white">✓</div>
        <h2 class="mt-5 text-2xl font-extrabold text-navy">¡Pedido <span data-order></span> enviado!</h2>
        <p class="mx-auto mt-2 max-w-md text-ink/60">Se abrió WhatsApp con el detalle de tu pedido. Si no se abrió, usa el botón de abajo. Te responderemos con la vista previa y los datos de pago.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3"><a data-reopen href="#" target="_blank" rel="noopener" data-wa-order class="btn bg-[#25d366] text-white">Abrir WhatsApp de nuevo</a><a href="/tienda" class="btn btn-outline">Seguir comprando</a></div>
      </div>

      <div id="full" class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <div class="overflow-hidden rounded-[2rem] border border-navy/10 bg-white shadow-soft">
            <div class="hidden grid-cols-[1fr_8rem_7rem] gap-4 border-b border-navy/10 px-6 py-4 text-xs font-bold uppercase tracking-wider text-ink/45 sm:grid">
              <span>Producto</span><span class="text-center">Cantidad</span><span class="text-right">Total</span>
            </div>
            <ul id="lines" class="divide-y divide-navy/8"></ul>
          </div>
          <a href="/tienda" class="mt-4 inline-block text-sm font-semibold text-teal">← Seguir comprando</a>
        </div>

        <form id="order-form" class="h-fit rounded-[2rem] border border-navy/10 bg-white p-6 shadow-soft sm:p-8 lg:sticky lg:top-28" novalidate>
          <h2 class="text-xl font-extrabold text-navy">Tus datos</h2>
          <div class="mt-5 grid gap-4">
            <label class="grid gap-1.5 text-sm font-semibold text-navy">Nombre<input name="nombre" class="field font-normal" required autocomplete="name" placeholder="¿A nombre de quién?" /></label>
            <label class="grid gap-1.5 text-sm font-semibold text-navy">Entrega
              <select name="entrega" class="field font-normal">
                <option value="lima">Delivery Lima y Callao</option>
                <option value="recojo">Recojo en taller (Los Olivos)</option>
                <option value="provincia">Envío a provincia (Shalom / Olva)</option>
              </select>
            </label>
            <label class="grid gap-1.5 text-sm font-semibold text-navy">Distrito o ciudad<input name="distrito" class="field font-normal" placeholder="Ej.: San Miguel" /></label>
            <div class="grid grid-cols-2 gap-3">
              <label class="grid gap-1.5 text-sm font-semibold text-navy">Pago
                <select name="pago" class="field font-normal"><option>Yape</option><option>Plin</option><option>Transferencia</option><option>Contra entrega</option></select>
              </label>
              <label class="grid gap-1.5 text-sm font-semibold text-navy">Para el<input name="fecha" type="date" class="field font-normal" /></label>
            </div>
            <label class="grid gap-1.5 text-sm font-semibold text-navy">Diseño o dedicatoria<textarea name="diseno" rows="3" class="field resize-none font-normal" placeholder="Nombres, frases, colores. Las fotos o logos los envías por el chat."></textarea></label>
          </div>
          <dl class="mt-6 grid gap-2 border-t border-navy/10 pt-5 text-sm">
            <div class="flex justify-between text-ink/65"><dt>Subtotal</dt><dd data-sub></dd></div>
            <div class="flex justify-between text-ink/65"><dt>Envío</dt><dd data-ship></dd></div>
            <div class="flex justify-between border-t border-navy/10 pt-3 text-lg font-extrabold text-navy"><dt>Total</dt><dd data-total></dd></div>
          </dl>
          <p data-free class="mt-3 rounded-2xl bg-gold/15 px-4 py-2.5 text-xs font-medium text-ink/75"></p>
          <p data-error class="mt-3 hidden text-sm font-medium text-red-600">Escribe tu nombre para enviar el pedido.</p>
          <button class="btn mt-5 w-full bg-[#25d366] !py-4 text-base text-white hover:-translate-y-0.5">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.8L.1 24l6.3-1.7a11.8 11.8 0 0 0 5.6 1.4 11.8 11.8 0 0 0 8.4-20.1z" /></svg>
            Enviar pedido por WhatsApp
          </button>
          <p class="mt-3 text-center text-xs text-ink/50">No pagas nada todavía: primero confirmamos tu diseño.</p>
        </form>
      </div>
    </div>
  </section>
</Shop>

<script>
  import { getItems, setQty, removeItem, subtotal, clearCart, pixelPayload, soles, unit } from '../scripts/cart';

  const FREE_FROM = 150;
  const SHIP_LIMA = 10;
  const form = document.getElementById('order-form') as HTMLFormElement;
  const lines = document.getElementById('lines')!;
  const show = (id: 'empty' | 'full' | 'done') =>
    ['empty', 'full', 'done'].forEach((x) => document.getElementById(x)!.classList.toggle('hidden', x !== id));

  const shipping = () => {
    const e = (form.elements.namedItem('entrega') as HTMLSelectElement).value;
    if (e !== 'lima') return 0;
    return subtotal() >= FREE_FROM ? 0 : SHIP_LIMA;
  };

  function render() {
    const items = getItems();
    if (!items.length) { if (document.getElementById('done')!.classList.contains('hidden')) show('empty'); return; }
    show('full');
    lines.innerHTML = items.map((it, i) => `
      <li class="grid grid-cols-[4.5rem_1fr] gap-4 px-6 py-5 sm:grid-cols-[4.5rem_1fr_8rem_7rem] sm:items-center">
        <img src="${it.img}" alt="" class="size-18 rounded-2xl object-cover" />
        <div class="min-w-0">
          <a href="/producto/${it.id}" class="font-semibold leading-snug text-navy hover:text-teal">${it.name}</a>
          <p class="text-xs text-ink/55">${it.option ?? (it.kind === 'pack' ? 'Pack' : '')}</p>
          <p class="text-sm text-ink/65">${soles(unit(it))}${it.dozen && it.qty >= 12 ? ' <span class="text-teal">(docena)</span>' : ''}</p>
          <button data-rm="${i}" class="mt-1 text-xs font-semibold text-ink/45 hover:text-red-600">Quitar</button>
        </div>
        <div class="col-start-2 flex w-fit items-center rounded-full border border-navy/15 sm:col-start-auto sm:mx-auto">
          <button data-i="${i}" data-d="-1" class="grid size-9 place-items-center" aria-label="Menos">−</button>
          <span class="w-8 text-center font-semibold">${it.qty}</span>
          <button data-i="${i}" data-d="1" class="grid size-9 place-items-center" aria-label="Más">+</button>
        </div>
        <p class="col-start-2 font-display font-extrabold text-ink sm:col-start-auto sm:text-right">${soles(unit(it) * it.qty)}</p>
      </li>`).join('');
    const sub = subtotal(items);
    const ship = shipping();
    const entrega = (form.elements.namedItem('entrega') as HTMLSelectElement).value;
    form.querySelector('[data-sub]')!.textContent = soles(sub);
    form.querySelector('[data-ship]')!.textContent = entrega === 'provincia' ? 'Pago en destino' : ship ? soles(ship) : 'Gratis';
    form.querySelector('[data-total]')!.textContent = soles(sub + ship);
    const free = form.querySelector<HTMLElement>('[data-free]')!;
    free.hidden = entrega !== 'lima';
    free.textContent = sub >= FREE_FROM ? '🎉 ¡Tienes delivery gratis en Lima!' : `Te faltan ${soles(FREE_FROM - sub)} para el delivery gratis en Lima.`;
  }

  lines.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    if (t.dataset.d) setQty(+t.dataset.i!, getItems()[+t.dataset.i!].qty + +t.dataset.d);
    if (t.dataset.rm) removeItem(+t.dataset.rm);
  });
  document.addEventListener('kc:cart', render);
  form.entrega.addEventListener('change', render);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const nombre = String(d.get('nombre') || '').trim();
    if (!nombre) { form.querySelector('[data-error]')!.classList.remove('hidden'); return; }
    form.querySelector('[data-error]')!.classList.add('hidden');

    const items = getItems();
    const id = 'KC-' + Date.now().toString().slice(-6);
    const sub = subtotal(items);
    const ship = shipping();
    const entregaTxt = form.entrega.selectedOptions[0].text;
    const fecha = d.get('fecha') ? new Date(String(d.get('fecha')) + 'T12:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'long' }) : 'por coordinar';
    const msg = [
      `Hola Karbell Crea 👋 Quiero hacer este pedido (${id}):`,
      '',
      ...items.map((it) => `• ${it.qty} × ${it.name}${it.option ? ` (${it.option})` : ''} = ${soles(unit(it) * it.qty)}`),
      '',
      `Subtotal: ${soles(sub)}`,
      `Envío: ${form.entrega.value === 'provincia' ? 'pago en destino' : ship ? soles(ship) : 'gratis'}`,
      `*Total: ${soles(sub + ship)}*`,
      '',
      `👤 ${nombre}`,
      `📦 ${entregaTxt}${d.get('distrito') ? ' · ' + d.get('distrito') : ''}`,
      `💳 ${d.get('pago')}`,
      `📅 Para el: ${fecha}`,
      d.get('diseno') ? `🎨 ${d.get('diseno')}` : '🎨 Les envío mi diseño por aquí.',
    ].join('\n');

    window.kcTrack('Purchase', { ...pixelPayload(items), value: Number((sub + ship).toFixed(2)), order_id: id });
    const url = window.kcWa(msg);
    document.querySelector('[data-order]')!.textContent = id;
    (document.querySelector('[data-reopen]') as HTMLAnchorElement).href = url;
    clearCart();
    show('done');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    window.open(url, '_blank', 'noopener');
  });

  render();
  const items = getItems();
  if (items.length) window.kcTrack('InitiateCheckout', pixelPayload(items));
</script>
